<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/nav_glass_panel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cornerRadius="0dp"
        app:glassMaterial="regular"
        app:refractionHeight="24dp"
        app:bevelWidth="8dp"
        app:dispersionStrength="0.08"
        app:enableAdaptiveTint="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nav_back_button"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_arrow_down"
                    android:rotation="90"
                    android:scaleType="centerInside"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/text_secondary" />

                <ImageView
                    android:id="@+id/nav_logo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_leaf_logo" />

                <TextView
                    android:id="@+id/nav_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/misans"
                    android:text="@string/app_name"
                    android:textColor="#8BC34A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <com.example.liquidglass.LiquidGlassTabBar
                android:id="@+id/nav_tab_bar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginStart="24dp"
                app:cornerRadius="999dp"
                app:glassMaterial="clear"
                app:refractionHeight="20dp"
                app:bevelWidth="6dp"
                app:dispersionStrength="0.06" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.liquidglass.LiquidGlassButton
                    android:id="@+id/nav_sign_in_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="@string/sign_in"
                    android:textSize="11sp"
                    android:textColor="@color/on_primary"
                    android:visibility="gone"
                    app:cornerRadius="999dp"
                    app:glassMaterial="regular"
                    app:refractionHeight="14dp"
                    app:bevelWidth="4dp" />

                <FrameLayout
                    android:id="@+id/nav_account_avatar_container"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:visibility="gone">

                    <com.microsoft.xbox.idp.toolkit.CircleImageView
                        android:id="@+id/nav_account_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/xbox_avatar"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_minecraft_cube" />

                    <ProgressBar
                        android:id="@+id/nav_avatar_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:visibility="gone" />
                </FrameLayout>

            </LinearLayout>

        </FrameLayout>
    </com.example.liquidglass.LiquidGlassView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_glass_floating_bar"
    android:elevation="6dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/nav_back_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_arrow_down"
                android:rotation="90"
                android:scaleType="centerInside"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/nav_logo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_leaf_logo" />

            <TextView
                android:id="@+id/nav_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/misans"
                android:text="@string/app_name"
                android:textColor="#8BC34A"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tab_bar"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nav_tab_launch"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:fontFamily="@font/misans"
                android:text="@string/nav_launch"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_filter_chip"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/nav_tab_instances"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:fontFamily="@font/misans"
                android:text="@string/nav_instances"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_chip"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/nav_tab_about"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:fontFamily="@font/misans"
                android:text="@string/nav_about"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_chip"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/nav_tab_settings"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:fontFamily="@font/misans"
                android:text="@string/nav_settings"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_chip"
                android:focusable="true"
                android:focusableInTouchMode="false" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nav_sign_in_button"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/sign_in"
                android:textSize="11sp"
                android:textColor="@color/on_primary"
                android:background="@drawable/bg_launch_button"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/nav_account_avatar_container"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:visibility="gone">

                <com.microsoft.xbox.idp.toolkit.CircleImageView
                    android:id="@+id/nav_account_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/xbox_avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_minecraft_cube" />

                <ProgressBar
                    android:id="@+id/nav_avatar_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
